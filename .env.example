# ---------- Database (required for the server version) ----------
# Postgres connection string. In production use the provider's POOLED url
# (Neon: the "-pooler" host; Supabase: port 6543 "Transaction" pooler).
DATABASE_URL=postgres://studyclip:studyclip@127.0.0.1:5433/studyclip
# Direct (non-pooled) url, used only by `npm run db:migrate`. `neon deploy` writes this one for you.
DATABASE_URL_UNPOOLED=
# Same thing for other providers (used when DATABASE_URL_UNPOOLED is empty).
DIRECT_DATABASE_URL=
# ---------- Login (Neon Auth) ----------
# `neon deploy` writes these two from the linked Neon branch.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Signs the cached session cookie. 32+ random characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Connections per server instance. Serverless: 1–3. A single long-running server: 10–40.
DB_POOL_MAX=3
# Requests one instance handles at once before answering 503 "busy, retry".
MAX_INFLIGHT=200

# ---------- Payments (Razorpay: Dashboard → Settings → API Keys; start with Test Mode keys) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://YOUR-DOMAIN/api/payments/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
# Local testing only: grant purchases without payment when no Razorpay keys are set. Never set in production.
PAYMENTS_DEMO=

# ---------- Admin ----------
# Accounts (comma-separated emails) that can open /admin/messages, the contact-form inbox.
ADMIN_EMAILS=

# ---------- AI doubt solver (optional) ----------
# Turns on "Solve with AI" on /learn for signed-in users. Each answer is a paid Claude API call.
ANTHROPIC_API_KEY=
# Model for the doubt solver (default claude-opus-5-5).
CLAUDE_MODEL=
# AI doubts per account per day (default 10).
DOUBT_DAILY_LIMIT=

# ---------- Daily study reminders (Web Push, optional) ----------
# Leave all four empty and the "Daily reminder" card on /today stays hidden.
# Generate the key pair once with: npx web-push generate-vapid-keys
# Public key (safe to expose; built into the browser bundle, so rebuild after changing it).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key. Server only; never commit it.
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:support@your-domain.example
VAPID_SUBJECT=
# Bearer secret the hourly Netlify function sends to /api/push/send. 32+ random characters: openssl rand -base64 32
CRON_SECRET=

# ---------- Shared rate limiting across instances (optional, recommended in production) ----------
# Upstash Redis (free tier): console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
